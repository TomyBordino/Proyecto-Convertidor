# Copiar a backend/.env y completar.
QB_DATA_PROVIDER=real
# Obligatorio para SEC EDGAR (política de acceso de la SEC): nombre y email de contacto.
QB_SEC_USER_AGENT="Nombre Apellido tu-email@dominio.com"
# Opcionales: mejoran calidad/cobertura.
QB_TIINGO_API_KEY=
QB_FMP_API_KEY=
QB_YAHOO_FALLBACK=true
QB_BYMA_SETTLEMENT=24HS
# QB_DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
# Capa de eventos: interpretación de noticias con Claude (opcional; sin clave las noticias
# se muestran sin clasificar). Obtener en https://console.anthropic.com
ANTHROPIC_API_KEY=
# QB_NEWS_MODEL=claude-opus-5-5
# QB_NEWS_MAX_TICKERS=120
