# Puerto donde corre el backend
PORT=4000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Opcional: si se define, la seccion de Analisis con IA usa un modelo de Anthropic
# real para redactar la narrativa en vez del generador heuristico por defecto.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: override de la URL base de la API publica data912 (cotizaciones Argentina)
# DATA912_BASE_URL=https://data912.com/live
